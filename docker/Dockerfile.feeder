FROM python:3.12-slim@sha256:c3d81d25b3154142b0b42eb1e61300024426268edeb5b5a26dd7ddf64d9daf28

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend:/app

WORKDIR /app

COPY sidecar/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --requirement /tmp/requirements.txt \
    && addgroup --system --gid 10001 sidecar \
    && adduser --system --uid 10001 --ingroup sidecar --home /nonexistent --no-create-home sidecar

COPY --chown=10001:10001 backend/integrity_core backend/integrity_core
COPY --chown=10001:10001 backend/app backend/app
COPY --chown=10001:10001 sidecar sidecar

USER 10001:10001
EXPOSE 8090
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8090/api/v1/integrity/health', timeout=2)"]

ENTRYPOINT ["python", "-m", "sidecar"]
