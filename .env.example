# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/adsb_intel

# dump1090 JSON endpoint
DUMP1090_URL=http://localhost:8080/data/aircraft.json

# Observation provenance (override source type for replay or external feeds)
OBSERVATION_SOURCE_TYPE=LIVE_RF
OBSERVATION_SOURCE_ID=dump1090-sbs
OBSERVATION_RECEIVER_ID=local-receiver
OBSERVATION_RECORDING_ID=

# Anthropic API Key for AI summaries
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anomaly detection thresholds
RAPID_DESCENT_THRESHOLD=4000
SPEED_ANOMALY_THRESHOLD=0.3
GHOST_FLIGHT_TIMEOUT=300
